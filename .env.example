# ──────────────────────────────────────────────────────────────
# Hassan's Toys World — environment variables
# Copy this file to `.env.local` and fill in the values.
# NEVER commit `.env.local`. NEVER share the service-role key.
# ──────────────────────────────────────────────────────────────

# Public site address (used for SEO, sitemap, social sharing).
# Local: http://localhost:3000  — Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → "service_role" key.
# SECRET. Server-only. Used to place customer orders and to manage admin accounts.
SUPABASE_SERVICE_ROLE_KEY=
